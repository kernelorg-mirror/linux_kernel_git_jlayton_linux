#
# Config options generated by splitconfig
#
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT_CLOCK=y
# CONFIG_PARAVIRT_DEBUG is not set
# CONFIG_PARAVIRT_SPINLOCKS is not set
# CONFIG_XEN is not set
# CONFIG_PVH is not set
CONFIG_PARAVIRT_TIME_ACCOUNTING=y
# CONFIG_JAILHOUSE_GUEST is not set
# CONFIG_ACRN_GUEST is not set
CONFIG_CPU_IDLE_GOV_HALTPOLL=y
CONFIG_HALTPOLL_CPUIDLE=y
# CONFIG_PTP_1588_CLOCK_KVM is not set
# CONFIG_PTP_1588_CLOCK_VMW is not set
# CONFIG_HYPERV is not set

# Mitigations are enabled in the hardened kernel
CONFIG_CPU_MITIGATIONS=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_MITIGATION_RETHUNK=y
CONFIG_MITIGATION_UNRET_ENTRY=y
CONFIG_MITIGATION_IBPB_ENTRY=y
CONFIG_MITIGATION_IBRS_ENTRY=y
CONFIG_MITIGATION_SRSO=y
CONFIG_MITIGATION_SLS=y
CONFIG_MITIGATION_RFDS=y
CONFIG_MITIGATION_SPECTRE_BHI=y
# CONFIG_MITIGATION_CALL_DEPTH_TRACKING is not set
# CONFIG_MITIGATION_GDS_FORCE is not set

CONFIG_INTEL_TDX_GUEST=n
# CONFIG_DMA_FENCE_TRACE is not set
CONFIG_DRM=m
# CONFIG_INTEL_MEI_HDCP is not set
# CONFIG_INTEL_MEI_PXP is not set
CONFIG_VMAP_PFN=y
CONFIG_DRM_MIPI_DSI=y
# Dependencies for DRM
# CONFIG_DRM_DEBUG_SELFTEST is not set
CONFIG_DRM_KMS_HELPER=y
# CONFIG_DRM_LOAD_EDID_FIRMWARE is not set
# CONFIG_DRM_TTM is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_VGEM is not set
# CONFIG_DRM_VKMS is not set
# CONFIG_DRM_VMWGFX is not set
# CONFIG_DRM_GMA500 is not set
# CONFIG_DRM_UDL is not set
# CONFIG_DRM_AST is not set
# CONFIG_DRM_MGAG200 is not set
# CONFIG_DRM_QXL is not set
# CONFIG_DRM_VIRTIO_GPU is not set
# CONFIG_DRM_ANALOGIX_ANX78XX is not set
# CONFIG_DRM_ETNAVIV is not set
# CONFIG_DRM_BOCHS is not set
# CONFIG_DRM_CIRRUS_QEMU is not set
# CONFIG_DRM_GM12U320 is not set
# CONFIG_DRM_PANEL_MIPI_DBI is not set
# CONFIG_DRM_SIMPLEDRM is not set
# CONFIG_TINYDRM_HX8357D is not set
# CONFIG_TINYDRM_ILI9163 is not set
# CONFIG_TINYDRM_ILI9225 is not set
# CONFIG_TINYDRM_ILI9341 is not set
# CONFIG_TINYDRM_ILI9486 is not set
# CONFIG_TINYDRM_MI0283QT is not set
# CONFIG_TINYDRM_REPAPER is not set
# CONFIG_TINYDRM_ST7586 is not set
# CONFIG_TINYDRM_ST7735R is not set
# CONFIG_DRM_VBOXVIDEO is not set
# CONFIG_DRM_SSD130X is not set
# CONFIG_DRM_LEGACY is not set
# CONFIG_DRM_GUD is not set
# CONFIG_SW_SYNC is not set
CONFIG_MTD_PARTITIONED_MASTER=y

# Enabling to get some production coverage with stack protection
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y

# i915 dependencies
CONFIG_AGP=m
CONFIG_AGP_INTEL=m
CONFIG_DRM_I915=m
CONFIG_DRM_I915_FORCE_PROBE=""
CONFIG_DRM_I915_CAPTURE_ERROR=y
CONFIG_DRM_I915_COMPRESS_ERROR=y
# CONFIG_DRM_I915_DEBUG is not set
# CONFIG_DRM_I915_DEBUG_GUC is not set
# CONFIG_DRM_I915_DEBUG_MMIO is not set
# CONFIG_DRM_I915_DEBUG_RUNTIME_PM is not set
# CONFIG_DRM_I915_DEBUG_VBLANK_EVADE is not set
CONFIG_DRM_I915_FENCE_TIMEOUT=10000
CONFIG_DRM_I915_HEARTBEAT_INTERVAL=2500
# CONFIG_DRM_I915_LOW_LEVEL_TRACEPOINTS is not set
CONFIG_DRM_I915_MAX_REQUEST_BUSYWAIT=8000
CONFIG_DRM_I915_PREEMPT_TIMEOUT=640
CONFIG_DRM_I915_PREEMPT_TIMEOUT_COMPUTE=7500
CONFIG_DRM_I915_REQUEST_TIMEOUT=20000
# CONFIG_DRM_I915_SELFTEST is not set
CONFIG_DRM_I915_STOP_TIMEOUT=100
# CONFIG_DRM_I915_SW_FENCE_CHECK_DAG is not set
# CONFIG_DRM_I915_SW_FENCE_DEBUG_OBJECTS is not set
# CONFIG_DRM_I915_WERROR is not set
# CONFIG_DRM_I915_GVT_KVMGT is not set
CONFIG_DRM_I915_TIMESLICE_DURATION=1
CONFIG_DRM_I915_USERFAULT_AUTOSUSPEND=250
CONFIG_DRM_I915_USERPTR=y
CONFIG_DRM_DISPLAY_HELPER=m
CONFIG_DRM_DISPLAY_DP_HELPER=y
CONFIG_DRM_DISPLAY_HDCP_HELPER=y
CONFIG_DRM_DISPLAY_HDMI_HELPER=y

# Required for TEE
# https://fb.workplace.com/groups/linux.fbk/permalink/7254704617895652/
CONFIG_SEV_GUEST=m

# use TICK_CPU_ACCOUNTING for hardened flavor
CONFIG_IRQ_TIME_ACCOUNTING=n
CONFIG_TICK_CPU_ACCOUNTING=y

# Ramdisk settings
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_COUNT=8
CONFIG_BLK_DEV_RAM_SIZE=10485760

CONFIG_FBNIC=y

CONFIG_CALL_DEPTH_TRACKING=y

CONFIG_FSCACHE=m

CONFIG_LTO_NONE=y

CONFIG_NODES_SHIFT=3

CONFIG_X86_KERNEL_IBT=y

CONFIG_DRM_ACCEL=y

CONFIG_CPU_IBPB_ENTRY=y
CONFIG_CPU_IBRS_ENTRY=y
CONFIG_CPU_UNRET_ENTRY=y

CONFIG_PAGE_TABLE_ISOLATION=y

CONFIG_IRQ_TIME_ACCOUNTING=y

CONFIG_RETHUNK=y
CONFIG_RETPOLINE=y

CONFIG_SPECULATION_MITIGATIONS=y

CONFIG_SCHED_CORE=y

CONFIG_SLS=y

# It can't be =m, as on 6.12 we use it will make CONFIG_MLX5_CORE=m (S559895)
# And we don't need it, so just disable it.
CONFIG_VXLAN=n

# ============================================================================
# KSPP hardening overrides
# Based on Kernel Self-Protection Project recommended settings
# ============================================================================

# --- Memory initialization ---
# Zero slab and page allocations on alloc and free to prevent info leaks
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
# Initialize all stack variables to zero on function entry
CONFIG_CC_HAS_AUTO_VAR_INIT_PATTERN=y
CONFIG_CC_HAS_AUTO_VAR_INIT_ZERO_BARE=y
CONFIG_CC_HAS_AUTO_VAR_INIT_ZERO=y
# CONFIG_INIT_STACK_NONE is not set
# CONFIG_INIT_STACK_ALL_PATTERN is not set
CONFIG_INIT_STACK_ALL_ZERO=y
# Wipe caller-used registers on function exit (reduces ROP gadgets)
CONFIG_ZERO_CALL_USED_REGS=y
# Erase kernel stack before returning from syscalls (prevents info leaks)
CONFIG_CC_HAS_SANCOV_STACK_DEPTH_CALLBACK=y
CONFIG_KSTACK_ERASE=y
CONFIG_KSTACK_ERASE_TRACK_MIN_SIZE=100
# CONFIG_KSTACK_ERASE_METRICS is not set
# CONFIG_KSTACK_ERASE_RUNTIME_DISABLE is not set

# --- KASLR ---
# Randomize kernel and memory layout
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
# Randomize kernel stack offset on syscall entry
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y

# --- Slab allocator hardening ---
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_BUCKETS=y
CONFIG_RANDOM_KMALLOC_CACHES=y
# Prevent cross-slab attacks by not merging similar slabs
# CONFIG_SLAB_MERGE_DEFAULT is not set
# Randomize page allocator freelists
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y

# --- Compile-time and runtime overflow detection ---
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_HARDENED_USERCOPY_DEFAULT_ON=y
# CONFIG_HARDENED_USERCOPY_FALLBACK is not set
# CONFIG_HARDENED_USERCOPY_PAGESPAN is not set

# --- Struct layout randomization ---
CONFIG_CC_HAS_RANDSTRUCT=y
# CONFIG_RANDSTRUCT_NONE is not set
CONFIG_RANDSTRUCT_FULL=y
CONFIG_RANDSTRUCT=y

# --- UBSAN bounds checking ---
CONFIG_UBSAN=y
CONFIG_UBSAN_TRAP=y
CONFIG_UBSAN_BOUNDS=y
CONFIG_UBSAN_SANITIZE_ALL=y
# Disable non-security UBSAN checks to minimize overhead
# CONFIG_UBSAN_SHIFT is not set
# CONFIG_UBSAN_DIV_ZERO is not set
# CONFIG_UBSAN_UNREACHABLE is not set
# CONFIG_UBSAN_SIGNED_WRAP is not set
# CONFIG_UBSAN_BOOL is not set
# CONFIG_UBSAN_ENUM is not set
# CONFIG_UBSAN_ALIGNMENT is not set

# --- Page table and memory validation ---
CONFIG_PAGE_TABLE_CHECK=y
CONFIG_PAGE_TABLE_CHECK_ENFORCED=y
CONFIG_DEBUG_WX=y
CONFIG_DEBUG_VIRTUAL=y

# --- Data structure validation ---
CONFIG_LIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_SG=y
CONFIG_DEBUG_NOTIFIERS=y
CONFIG_DEBUG_VFS=y
CONFIG_SCHED_STACK_END_CHECK=y

# --- Kernel address exposure restrictions ---
CONFIG_SECURITY_DMESG_RESTRICT=y

# --- Build hardening ---
CONFIG_WERROR=y
CONFIG_LD_ORPHAN_WARN_LEVEL="error"

# --- /dev/mem and device memory ---
CONFIG_DEVMEM=y
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y

# --- /proc hardening ---
# CONFIG_PROC_KCORE is not set
CONFIG_PROC_MEM_NO_FORCE=y

# --- Remove 32-bit attack surface ---
# CONFIG_IA32_EMULATION is not set
# CONFIG_COMPAT is not set
# CONFIG_X86_X32_ABI is not set
# CONFIG_MODIFY_LDT_SYSCALL is not set

# --- Disable fixed-position ROP targets ---
# CONFIG_X86_VSYSCALL_EMULATION is not set
CONFIG_LEGACY_VSYSCALL_NONE=y
# CONFIG_LEGACY_VSYSCALL_XONLY is not set
# CONFIG_COMPAT_VDSO is not set

# --- ASLR ---
# CONFIG_COMPAT_BRK is not set
# Disable Linear Address Masking (weakens ASLR)
# CONFIG_ADDRESS_MASKING is not set

# --- Misc attack surface reduction ---
# CONFIG_BINFMT_MISC is not set
# CONFIG_LDISC_AUTOLOAD is not set
# CONFIG_LEGACY_TIOCSTI is not set
# Don't automount tracefs on debugfs
# CONFIG_TRACEFS_AUTOMOUNT_DEPRECATED is not set

# --- Oops/panic behavior ---
CONFIG_PANIC_TIMEOUT=-1

# --- Module signing ---
CONFIG_MODULE_SIG_ALL=y


# --- IOMMU hardening ---
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y
# CONFIG_IOMMU_DEFAULT_DMA_LAZY is not set
CONFIG_INTEL_IOMMU_DEFAULT_ON=y

# --- EFI/boot hardening ---
CONFIG_EFI_DISABLE_PCI_DMA=y
CONFIG_RESET_ATTACK_MITIGATION=y

# --- Control Flow Integrity (kCFI) ---
# Forward-edge CFI via clang's -fsanitize=kcfi
CONFIG_CFI=y
# Normalize integer CFI tags (needed for Rust interop, improves type matching)
CONFIG_CFI_ICALL_NORMALIZE_INTEGERS=y
# Attempt FineIBT by default at boot (cfi=auto)
CONFIG_CFI_AUTO_DEFAULT=y
# CFI violations must be fatal
# CONFIG_CFI_PERMISSIVE is not set
# FineIBT: combined IBT + kCFI with arity checking
CONFIG_CC_HAS_KCFI_ARITY=y
CONFIG_FUNCTION_PADDING_CFI=11
CONFIG_FUNCTION_PADDING_BYTES=11
CONFIG_CALL_PADDING=y
CONFIG_FINEIBT=y
CONFIG_FINEIBT_BHI=y
CONFIG_ARCH_USES_CFI_TRAPS=y

# --- CET Shadow Stack for userspace ---
CONFIG_X86_USER_SHADOW_STACK=y

# --- Memory sealing ---
# Seal system mappings (vdso, vvar) against modification
CONFIG_MSEAL_SYSTEM_MAPPINGS=y

# -- make landlock available
CONFIG_SECURITY_LANDLOCK=y
