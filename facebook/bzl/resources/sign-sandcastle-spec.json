{
    "command": "SandcastleKernelSignCommand",
    "args": {
        "build_mode": "signing",
        "everstore_handle": "$EVERSTORE_HANDLE",
        "sign_modules_key": "$SIGN_KEY"
    },
    "capabilities": {
        "type": "lego",
        "vcs": "linux-kernel-git",
        "tenant": "kernel"
    },
    "required_tag_identities": ["kernel_kannery_ci"],
    "nonce": "$SANDCASTLE_NONCE",
    "alias": "kernel-kernel-signing",
    "oncall": "kernel_infra",
    "hash": "$KERNEL_COMMIT"
}
